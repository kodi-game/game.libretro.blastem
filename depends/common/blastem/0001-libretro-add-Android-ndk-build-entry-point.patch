diff --git a/android/app/jni/Android.mk b/android/app/jni/Android.mk
index 5053e7d..207dddb 100644
--- a/android/app/jni/Android.mk
+++ b/android/app/jni/Android.mk
@@ -1 +1,7 @@
+# Gradle opts into the standalone SDL application. Direct ndk-build consumers
+# use the libretro entry point, including callers of this newer app/jni path.
+ifeq ($(BLASTEM_STANDALONE),1)
 include $(call all-subdir-makefiles)
+else
+include $(call my-dir)/../../jni/Android.mk
+endif
diff --git a/android/app/jni/Application.mk b/android/app/jni/Application.mk
index 12bad51..6934ea1 100644
--- a/android/app/jni/Application.mk
+++ b/android/app/jni/Application.mk
@@ -4,7 +4,12 @@
 # https://developer.android.com/ndk/guides/cpp-support
 # APP_STL := c++_shared
 
+ifeq ($(BLASTEM_STANDALONE),1)
+# Keep every ABI supported by the standalone Gradle application.
 APP_ABI := armeabi-v7a arm64-v8a x86 x86_64
+else
+APP_ABI := armeabi-v7a arm64-v8a x86
+endif
 
 # Min runtime API level
 APP_PLATFORM=android-19
diff --git a/android/jni/Android.mk b/android/jni/Android.mk
new file mode 100644
index 0000000..d0065d6
--- /dev/null
+++ b/android/jni/Android.mk
@@ -0,0 +1,43 @@
+LOCAL_PATH := $(call my-dir)
+BLASTEM_ROOT := $(LOCAL_PATH)/../..
+
+# This is the stable ndk-build entry point for the libretro core. Its object
+# graph is shared with Makefile.libretro through the root makefile fragment.
+MEM := mem.o
+TERMINAL := terminal.o
+NET := net.o
+
+ifeq ($(TARGET_ARCH_ABI),x86)
+CPU := i686
+CFLAGS := -DX86_32
+else ifeq ($(TARGET_ARCH_ABI),armeabi-v7a)
+CPU := armv7
+NEW_CORE := 1
+else ifeq ($(TARGET_ARCH_ABI),arm64-v8a)
+CPU := aarch64
+NEW_CORE := 1
+else
+$(error Unsupported BlastEm libretro Android ABI: $(TARGET_ARCH_ABI))
+endif
+
+ifdef NOGL
+CFLAGS += -DDISABLE_OPENGL
+endif
+
+include $(BLASTEM_ROOT)/Makefile.libretro.sources
+
+ifneq ($(filter clean,$(MAKECMDGOALS)),clean)
+BLASTEM_MAKE := $(if $(GNUMAKE),$(GNUMAKE),$(MAKE))
+BLASTEM_GENERATE_RESULT := $(shell $(BLASTEM_MAKE) --no-print-directory -C $(BLASTEM_ROOT) libretro-generated-sources >/dev/null && echo ok || echo failed)
+ifneq ($(BLASTEM_GENERATE_RESULT),ok)
+$(error Failed to generate BlastEm libretro sources)
+endif
+endif
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := retro
+LOCAL_SRC_FILES := $(addprefix ../../,$(sort $(LIBOBJS:.o=.c)))
+LOCAL_C_INCLUDES := $(addprefix $(BLASTEM_ROOT)/,$(patsubst -I%,%,$(CHD_CFLAGS)))
+LOCAL_CFLAGS := -std=gnu99 -DIS_LIB -DDISABLE_NUKLEAR -DHAVE_UNISTD_H $(CFLAGS)
+LOCAL_LDLIBS := -lm
+include $(BUILD_SHARED_LIBRARY)
diff --git a/android/jni/Application.mk b/android/jni/Application.mk
new file mode 100644
index 0000000..c9538cf
--- /dev/null
+++ b/android/jni/Application.mk
@@ -0,0 +1,2 @@
+APP_ABI := armeabi-v7a arm64-v8a x86
+APP_PLATFORM := android-19
